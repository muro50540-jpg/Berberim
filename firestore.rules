rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.email == 'kadirpak@gmail.com'; }
    function anonymous() { return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous'; }

    match /slots/{id} {
      allow read: if true;
      allow create, update: if anonymous() || admin();
      allow delete: if admin();
    }

    match /appointments/{id} {
      allow create: if anonymous();
      allow read, update, delete: if admin();
    }
  }
}
