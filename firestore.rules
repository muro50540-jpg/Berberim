rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.email == 'kadirpak@gmail.com'; }
    function anonymous() { return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous'; }

    match /slots/{id} {
      allow read: if anonymous();
      allow create: if anonymous()
        && request.resource.data.taken == true
        && request.resource.data.date is string
        && request.resource.data.time is string
        && request.resource.data.appointmentId is string
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if admin();
    }

    match /appointments/{id} {
      allow create: if anonymous()
        && request.resource.data.status == 'Bekliyor'
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.date is string
        && request.resource.data.time is string
        && request.resource.data.service is string
        && request.resource.data.serviceId is string
        && request.resource.data.price is number
        && request.resource.data.slotId is string
        && request.resource.data.createdBy == request.auth.uid;
      allow read, update, delete: if admin();
    }
  }
}
